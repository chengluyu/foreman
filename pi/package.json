{
  "name": "pi-foreman",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Foreman lead workflow for Pi with Markdown briefs and runtime PR watches",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/foreman.ts"
    ],
    "skills": [
      "./node_modules/@aliou/pi-processes/skills"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:processes": "node tests/process-smoke.mjs"
  },
  "dependencies": {
    "@aliou/pi-processes": "0.13.2"
  },
  "overrides": {
    "@aliou/pi-processes": {
      "@aliou/pi-utils-settings": "0.23.0"
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.1.0 <2",
    "typebox": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
